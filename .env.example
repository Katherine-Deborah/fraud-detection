# Copy this file to .env and fill in real values before running
# `docker compose up` with the Airflow services (Session 4). .env is
# gitignored -- these are dev-only secrets for a local demo stack, not
# production credentials.

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_WEBSERVER_SECRET_KEY=

# Login for the Airflow UI (http://localhost:8080), username "admin".
AIRFLOW_ADMIN_PASSWORD=admin
